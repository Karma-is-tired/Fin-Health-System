# Copy this file to ".env" for local work. Never commit the real ".env".
# On Render, add these under Environment instead.

# Long random text. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Websites allowed to call the API (comma separated, no spaces)
ALLOWED_ORIGINS=https://fin-health-system.vercel.app,http://localhost:5173

# Optional
# CURRENCY_SYMBOL=₦
# DB_PATH=database/finance_tool.db
